generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url is now configured in prisma.config.ts (Prisma 7 breaking change)
}

enum ProjectStatus {
  ACTIVE
  SUSPENDED
  TAMPERED
}

enum PairingStatus {
  PENDING
  CLAIMED
  EXPIRED
}

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  email     String    @unique
  phone     String
  password  String    // bcrypt hashed
  role      String    @default("DEVELOPER") // "ADMIN" | "DEVELOPER"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]

  @@map("users")
}

model Project {
  id            String        @id @default(cuid())
  apiKey        String        @unique @default(uuid())
  name          String
  domain        String        @unique
  serverIp      String?
  status        ProjectStatus @default(ACTIVE)
  gracePeriod   Int           @default(24) // dalam jam
  lastHeartbeat DateTime?
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  logs          ActivityLog[]

  @@map("projects")
}

model ActivityLog {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event     String   // "REGISTER", "SUSPENDED", "ACTIVATED", "TAMPER_ATTEMPT"
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

model PairingSession {
  id        String        @id @default(cuid())
  code      String        @unique // e.g. LG-8492-XK91
  status    PairingStatus @default(PENDING)
  domain    String?
  apiKey    String?
  projectId String?
  createdAt DateTime      @default(now())
  expiresAt DateTime

  @@index([code])
  @@map("pairing_sessions")
}
