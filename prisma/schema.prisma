generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url is now configured in prisma.config.ts (Prisma 7 breaking change)
}

enum ProjectStatus {
  ACTIVE
  SUSPENDED
  TAMPERED
}

enum PairingStatus {
  PENDING
  CLAIMED
  EXPIRED
}

enum PlanTier {
  FREE
  PLUS
  PRO
  MAX
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  phone         String
  password      String    // bcrypt hashed
  role          String    @default("DEVELOPER") // "ADMIN" | "DEVELOPER"
  plan          PlanTier  @default(FREE)
  planStartedAt DateTime?
  planExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      Project[]
  lockTemplates LockTemplate[]
  userLogs      UserLog[]

  @@map("users")
}

model Project {
  id            String        @id @default(cuid())
  apiKey        String        @unique @default(uuid())
  name          String
  domain        String        @unique
  serverIp      String?
  status        ProjectStatus @default(ACTIVE)
  gracePeriod   Int           @default(24) // dalam jam
  lastHeartbeat DateTime?
  frameworkType String        @default("NATIVE") // "NATIVE" | "FRAMEWORK"
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  templateId    String?
  template      LockTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  logs          ActivityLog[]

  @@map("projects")
}

model LockTemplate {
  id          String    @id @default(cuid())
  name        String
  htmlContent String    @db.Text
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]

  @@map("lock_templates")
}

model ActivityLog {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event     String   // "REGISTER", "SUSPENDED", "ACTIVATED", "TAMPER_ATTEMPT"
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

model PairingSession {
  id        String        @id @default(cuid())
  code      String        @unique // e.g. LG-8492-XK91
  status    PairingStatus @default(PENDING)
  domain    String?
  apiKey    String?
  projectId String?
  createdAt DateTime      @default(now())
  expiresAt DateTime

  @@index([code])
  @@map("pairing_sessions")
}

model PlanSetting {
  id               String   @id // "FREE", "PLUS", "PRO", "MAX"
  name             String
  price            Int
  maxProjects      Int      // banyaknya domain
  retentionDays    Int      // log dari penggunaan (hari)
  maxLockTemplates Int      @default(0) // kuota template layar kunci kustom
  tagline          String   @default("")
  features         String[]
  updatedAt        DateTime @updatedAt

  @@map("plan_settings")
}

model UserLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  username  String?
  action    String   // "LOGIN", "LOGOUT", "USER_CREATED", "USER_UPDATED", "PASSWORD_CHANGED", "PLAN_CHANGED"
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("user_logs")
}


